#!/bin/bash
# Repository example launcher; each example owns its interaction and result.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1

names=(select checkbox dependencies lock keybindings wizard)
descriptions=(
    'Choose one item from grouped options'
    'Check several items, some preselected'
    'Checking an item adds what it requires'
    'Required items stay locked while needed'
    'The same checklist with remapped keys'
    'Steps with back navigation and a review'
)

list_examples() {
    local i
    for ((i=0; i<${#names[@]}; i++)); do
        printf '  %s. %-14s %s\n' "$((i + 1))" "${names[i]}" "${descriptions[i]}"
    done
}

usage() {
    printf 'Usage: %s [select|checkbox|dependencies|lock|keybindings|wizard|--list]\n' "$0"
}

run_example() {
    case $1 in
        lock) /bin/bash "$ROOT/examples/dependencies.sh" lock ;;
        select|checkbox|dependencies|keybindings|wizard)
            /bin/bash "$ROOT/examples/$1.sh"
            ;;
        *) printf 'Unknown example: %s\n' "$1" >&2; usage >&2; return 2 ;;
    esac
}

if (($#)); then
    if (($# != 1)); then usage >&2; exit 2; fi
    case $1 in
        --list) list_examples; exit 0 ;;
        --help|-h) usage; list_examples; exit 0 ;;
        *) run_example "$1"; exit $? ;;
    esac
fi

if [[ ! -t 0 || ! -t 1 ]]; then
    list_examples
    printf 'The menu needs a terminal. Use --list or specify an example name.\n' >&2
    exit 2
fi

source "$ROOT/lib/picker.sh" || exit 2
PICK_PROMPT='bash-prompts examples'
PICK_ID=("${names[@]}")
PICK_LABEL=()
for ((i=0; i<${#names[@]}; i++)); do
    PICK_LABEL[i]=$(printf '%-13s %s' "${names[i]}" "${descriptions[i]}")
done
PICK_FOCUS_COLOR=cyan

while true; do
    if pick_select; then
        :
    else
        rc=$?
        if ((rc == 1)); then exit 0; fi
        exit "$rc"
    fi
    # Each example runs inline below the menu's position; its result stays
    # in the scrollback and the menu reopens underneath it.
    printf '== %s ==\n' "$PICK_VALUE"
    run_example "$PICK_VALUE"
    rc=$?
    if ((rc > 1)); then printf 'Example ended with status %s.\n' "$rc" >&2; fi
    printf '\n'
done
